# ─────────────────────────────────────────────────────────────────────────────
# WhatsNexus backend — Meta Embedded Signup (+ Business App coexistence)
#
# This template lists ONLY the Embedded Signup variables. Copy the block you need
# into your real .env (never commit real values). Existing manual / legacy WhatsApp
# clients do not use any of these and are unaffected when they are unset.
#
# ONE Meta app + ONE Embedded Signup Login Configuration serve BOTH onboarding
# modes. The mode decides the Meta Feature Type at launch:
#   Standard   (EMBEDDED_STANDARD)   → Feature Type: None
#   Coexistence (EMBEDDED_COEXISTENCE) → Feature Type: WhatsApp Business App Onboarding
# ─────────────────────────────────────────────────────────────────────────────

# Backend copy of the provider Meta App ID (must equal NEXT_PUBLIC_WHATSNEXUS_META_APP_ID)
WHATSNEXUS_META_APP_ID=

# Backend-only Meta App Secret. NEVER expose to the frontend or logs.
WHATSNEXUS_META_APP_SECRET=

# Single Embedded Signup Login Configuration ID — used for Standard AND Coexistence
# (must equal NEXT_PUBLIC_WHATSNEXUS_EMBEDDED_SIGNUP_CONFIG_ID)
WHATSNEXUS_EMBEDDED_SIGNUP_CONFIG_ID=

# Graph API version for Embedded Signup calls (optional).
# Falls back to the existing project-wide META_API_VERSION, then v25.0.
WHATSNEXUS_META_GRAPH_API_VERSION=

# ── Reserved provider settings ───────────────────────────────────────────────
# Documented for the provider (Tech Provider) setup. The current code does NOT read
# them yet; set them only when a feature that needs them is enabled.

# Provider Business Portfolio ID
WHATSNEXUS_META_BUSINESS_ID=

# Provider system user
WHATSNEXUS_META_SYSTEM_USER_ID=

# Backend-only system-user token. NEVER expose to the frontend or logs.
WHATSNEXUS_META_SYSTEM_USER_ACCESS_TOKEN=

# Created by WhatsNexus; configure the identical value in the Meta app's webhook settings.
# (Existing client-specific webhooks keep using their per-tenant verify tokens.)
WHATSNEXUS_META_WEBHOOK_VERIFY_TOKEN=

# ── Deprecated — do not use ──────────────────────────────────────────────────
# META_EMBEDDED_SIGNUP_CONFIG_ID              → renamed WHATSNEXUS_EMBEDDED_SIGNUP_CONFIG_ID
#                                               (still read as a fallback, with a warning)
# META_EMBEDDED_SIGNUP_COEXISTENCE_CONFIG_ID  → removed; one configuration serves both modes
#
# Not used by Embedded Signup on purpose: the generic META_APP_ID / META_APP_SECRET.
# Legacy code (media gallery, templates, campaigns) falls back to META_APP_ID, so
# reusing that name here could pair Embedded Signup with the wrong app.
#
# Customer WABA IDs and Phone Number IDs are tenant data stored in the database after
# onboarding. Never put them in the environment.
